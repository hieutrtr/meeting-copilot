{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Copilot",
  "version": "0.0.0",
  "identifier": "dev.hieutran.meeting-copilot",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Copilot",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Meeting Copilot — Phase 0 scaffold",
    "longDescription": "Meeting Copilot Phase 0 Tauri scaffold. See docs/IMPLEMENTATION-PLAN.md."
  }
}
